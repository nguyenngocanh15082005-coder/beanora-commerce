# PostgreSQL — bắt buộc
DATABASE_URL="postgresql://beanora:beanora@localhost:5432/beanora?schema=public"

# Bảo mật ứng dụng — tạo chuỗi ngẫu nhiên tối thiểu 32 ký tự cho production
AUTH_SECRET="replace-with-openssl-rand-base64-32"
APP_URL="http://localhost:3000"

# Chỉ dùng khi chạy seed; production nên đặt SEED_ADMIN_ONLY=true và mật khẩu riêng
SEED_ADMIN_EMAIL="admin@beanora.vn"
SEED_ADMIN_PASSWORD="replace-with-a-strong-local-password"
SEED_ADMIN_ONLY="false"

# Email Resend — để trống nghĩa là email chưa được tích hợp, hệ thống sẽ ghi SKIPPED
RESEND_API_KEY=""
RESEND_FROM="Beanora <orders@your-domain.vn>"
ADMIN_EMAIL=""

# AI OpenAI — chỉ đọc ở server; để trống sẽ dùng trợ lý tra cứu danh mục nội bộ
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Webhook thanh toán — chỉ cấu hình khi có nhà cung cấp thật
PAYMENT_WEBHOOK_SECRET=""

# Vận chuyển — tích hợp khi có API chính thức
GHN_TOKEN=""
GHN_SHOP_ID=""
